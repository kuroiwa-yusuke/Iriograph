{
  "name": "@iriograph/vue-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/iriograph-vue-editor.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/iriograph-vue-editor.css"
    }
  },
  "dependencies": {
    "@iriograph/core": "0.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.3",
    "vue": "^3.5.16",
    "vue-tsc": "^3.0.4"
  }
}
