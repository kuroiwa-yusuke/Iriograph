{
  "name": "@iriograph/vue-editor",
  "version": "0.10.2",
  "description": "Embeddable Vue editor for Iriograph semantic diagrams.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/vue-editor"
  },
  "homepage": "https://github.com/kuroiwa-yusuke/Iriograph#readme",
  "bugs": {
    "url": "https://github.com/kuroiwa-yusuke/Iriograph/issues"
  },
  "keywords": [
    "vue",
    "rdf",
    "turtle",
    "diagram",
    "editor"
  ],
  "main": "./dist/iriograph-vue-editor.js",
  "module": "./dist/iriograph-vue-editor.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/iriograph-vue-editor.js",
      "default": "./dist/iriograph-vue-editor.js"
    },
    "./styles.css": {
      "default": "./dist/iriograph-vue-editor.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@iriograph/core": "0.10.2",
    "@iriograph/semantic-access": "0.10.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.11.6",
    "vite": "^7.1.3",
    "vue": "^3.5.16",
    "vue-tsc": "^3.0.4"
  }
}
