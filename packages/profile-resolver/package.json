{
  "name": "@iriograph/profile-resolver",
  "version": "0.12.3",
  "description": "Host-side immutable authoring profile and vocabulary resolver for Iriograph.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/profile-resolver"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "README_ja.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.19" },
  "dependencies": { "@iriograph/core": "0.12.3" },
  "devDependencies": { "typescript": "^5.8.3", "vitest": "^4.1.8" }
}
