{
  "name": "@iriograph/profile-kit",
  "version": "0.11.2",
  "description": "Domain projection profile manifest and conformance kit for Iriograph.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/profile-kit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "README_ja.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.19" },
  "dependencies": { "@iriograph/core": "0.11.2" },
  "devDependencies": { "typescript": "^5.8.3", "vitest": "^4.1.8" }
}
