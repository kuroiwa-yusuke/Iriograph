{
  "name": "@iriograph/semantic-access",
  "version": "0.12.1",
  "description": "Label-first semantic index and revision-safe authoring facade for Iriograph.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/semantic-access"
  },
  "homepage": "https://github.com/kuroiwa-yusuke/Iriograph#readme",
  "bugs": {
    "url": "https://github.com/kuroiwa-yusuke/Iriograph/issues"
  },
  "keywords": [
    "rdf",
    "rdfs",
    "turtle",
    "semantic-search",
    "llm"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@iriograph/core": "0.12.1",
    "@types/n3": "^1.26.0",
    "n3": "^1.26.0"
  }
}
