{
  "name": "@iriograph/agent-bridge",
  "version": "0.12.1",
  "description": "Revision-safe semantic transport, request routing, and external candidate review for Iriograph hosts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/agent-bridge"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "README_ja.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.19" },
  "dependencies": {
    "@iriograph/core": "0.12.1",
    "@iriograph/profile-resolver": "0.12.1",
    "@iriograph/semantic-access": "0.12.1"
  },
  "devDependencies": { "typescript": "^5.8.3", "vitest": "^4.1.8" }
}
