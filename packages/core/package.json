{
  "name": "@iriograph/core",
  "version": "0.5.0",
  "description": "Framework-independent semantic graph projection and validation for Iriograph.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroiwa-yusuke/Iriograph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kuroiwa-yusuke/Iriograph#readme",
  "bugs": {
    "url": "https://github.com/kuroiwa-yusuke/Iriograph/issues"
  },
  "keywords": [
    "rdf",
    "rdfs",
    "turtle",
    "diagram",
    "semantic-graph"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "assets",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./icons/*": "./assets/icons/*",
    "./THIRD_PARTY_NOTICES.md": "./THIRD_PARTY_NOTICES.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@types/n3": "^1.26.0",
    "ajv": "^8.20.0",
    "n3": "^1.26.0"
  }
}
