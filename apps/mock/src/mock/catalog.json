{
  "schemaVersion": "1",
  "kind": "iriograph.catalog",
  "catalogId": "urn:iriograph:catalog:workflow-mock",
  "catalogVersion": "1",
  "profileRef": "urn:iriograph:profile:rdf-rdfs:1",
  "rules": [
    {
      "ruleId": "workflow:start-event",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:StartEvent",
        "entailment": "exact"
      },
      "project": {
        "operator": "resource",
        "structuralKind": "node"
      },
      "templateRef": "urn:iriograph:template:start-event:1"
    },
    {
      "ruleId": "workflow:user-task",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:UserTask",
        "entailment": "exact"
      },
      "project": {
        "operator": "resource",
        "structuralKind": "node"
      },
      "templateRef": "urn:iriograph:template:user-task:1"
    },
    {
      "ruleId": "workflow:service-task",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:ServiceTask",
        "entailment": "exact"
      },
      "project": {
        "operator": "resource",
        "structuralKind": "node"
      },
      "templateRef": "urn:iriograph:template:service-task:1"
    },
    {
      "ruleId": "workflow:exclusive-gateway",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:ExclusiveGateway",
        "entailment": "exact"
      },
      "project": {
        "operator": "alternative",
        "ordinalPredicatePrefix": "http://www.w3.org/1999/02/22-rdf-syntax-ns#_",
        "defaultOrdinal": 1
      },
      "templateRef": "urn:iriograph:template:gateway:1"
    },
    {
      "ruleId": "workflow:end-event",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:EndEvent",
        "entailment": "exact"
      },
      "project": {
        "operator": "resource",
        "structuralKind": "node"
      },
      "templateRef": "urn:iriograph:template:end-event:1"
    },
    {
      "ruleId": "workflow:reference",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "urn:iriograph:demo:Reference",
        "entailment": "exact"
      },
      "project": {
        "operator": "resource",
        "structuralKind": "node"
      },
      "templateRef": "urn:iriograph:template:reference:1"
    },
    {
      "ruleId": "workflow:sequence-appearance",
      "priority": 200,
      "match": {
        "kind": "type",
        "iri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq",
        "entailment": "exact"
      },
      "project": {
        "operator": "ordinal-sequence",
        "ordinalPredicatePrefix": "http://www.w3.org/1999/02/22-rdf-syntax-ns#_"
      },
      "templateRef": "urn:iriograph:template:sequence-flow:1"
    }
  ],
  "templates": {
    "urn:iriograph:template:lane:1": {
      "templateRef": "urn:iriograph:template:lane:1",
      "structuralKind": "container",
      "headerPosition": "left",
      "style": {
        "fill": "#f8fbf9",
        "stroke": "#b4c5c2",
        "text": "#345054",
        "accent": "#dbe9e5"
      },
      "defaultSize": { "width": 1000, "height": 230 }
    },
    "urn:iriograph:template:start-event:1": {
      "templateRef": "urn:iriograph:template:start-event:1",
      "structuralKind": "node",
      "shape": "circle",
      "style": {
        "fill": "#e9f8ee",
        "stroke": "#30925b",
        "text": "#1d6640",
        "accent": "#30925b"
      },
      "defaultSize": { "width": 58, "height": 58 }
    },
    "urn:iriograph:template:user-task:1": {
      "templateRef": "urn:iriograph:template:user-task:1",
      "structuralKind": "node",
      "shape": "rounded-rectangle",
      "iconRef": "urn:iriograph:icon:user-task:1",
      "style": {
        "fill": "#fffdf5",
        "stroke": "#c1963f",
        "text": "#493c23",
        "accent": "#e9c66e"
      },
      "defaultSize": { "width": 170, "height": 76 }
    },
    "urn:iriograph:template:service-task:1": {
      "templateRef": "urn:iriograph:template:service-task:1",
      "structuralKind": "node",
      "shape": "rounded-rectangle",
      "iconRef": "urn:iriograph:icon:service-task:1",
      "style": {
        "fill": "#eef7f7",
        "stroke": "#3a8589",
        "text": "#234f52",
        "accent": "#66adb0"
      },
      "defaultSize": { "width": 170, "height": 76 }
    },
    "urn:iriograph:template:gateway:1": {
      "templateRef": "urn:iriograph:template:gateway:1",
      "structuralKind": "node",
      "shape": "diamond",
      "style": {
        "fill": "#fff5d9",
        "stroke": "#b47c16",
        "text": "#624712",
        "accent": "#b47c16"
      },
      "defaultSize": { "width": 84, "height": 84 }
    },
    "urn:iriograph:template:end-event:1": {
      "templateRef": "urn:iriograph:template:end-event:1",
      "structuralKind": "node",
      "shape": "circle",
      "style": {
        "fill": "#fceeed",
        "stroke": "#b8514d",
        "text": "#7a302d",
        "accent": "#b8514d"
      },
      "defaultSize": { "width": 58, "height": 58 }
    },
    "urn:iriograph:template:reference:1": {
      "templateRef": "urn:iriograph:template:reference:1",
      "structuralKind": "node",
      "shape": "rectangle",
      "iconRef": "urn:iriograph:icon:reference:1",
      "style": {
        "fill": "#fffef8",
        "stroke": "#879697",
        "text": "#243b3d",
        "accent": "#879697"
      },
      "defaultSize": { "width": 168, "height": 72 }
