        "text": "#3b5558"
      }
    }
  },
  "assets": {
    "urn:iriograph:icon:user-task:1": {
      "assetRef": "urn:iriograph:icon:user-task:1",
      "mediaType": "image/svg+xml",
      "url": "urn:iriograph:mock-asset-source:user-task"
    },
    "urn:iriograph:icon:service-task:1": {
      "assetRef": "urn:iriograph:icon:service-task:1",
      "mediaType": "image/svg+xml",
      "url": "urn:iriograph:mock-asset-source:service-task"
    },
    "urn:iriograph:icon:reference:1": {
      "assetRef": "urn:iriograph:icon:reference:1",
