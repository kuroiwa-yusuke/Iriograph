  "semantic": {
    "format": "text/turtle",
    "baseIri": "urn:iriograph:demo:",
    "authoringProfileRef": "urn:iriograph:authoring-profile:workflow-mock@1",
    "source": "@prefix wf: <urn:iriograph:demo:> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\nwf:requesterLane a rdf:Bag ;\n  rdfs:label \"申請者\"@ja ;\n  rdfs:member wf:start, wf:submit .\n\nwf:operationsLane a rdf:Bag ;\n  rdfs:label \"業務オペレーション\"@ja ;\n  rdfs:member wf:review, wf:approvalPolicy, wf:gateway, wf:register, wf:rework, wf:end .\n\nwf:mainFlow a rdf:Seq ;\n  rdfs:label \"購入申請フロー\"@ja ;\n  rdf:_1 wf:start ;\n  rdf:_2 wf:submit ;\n  rdf:_3 wf:review ;\n  rdf:_4 wf:gateway .\n\nwf:gateway a rdf:Alt, wf:ExclusiveGateway ;\n  rdfs:label \"承認？\"@ja ;\n  rdf:_1 wf:approvedPath ;\n  rdf:_2 wf:reworkPath .\n\nwf:approvedPath a rdf:Seq ;\n  rdfs:label \"承認\"@ja ;\n  rdf:_1 wf:register ;\n  rdf:_2 wf:end .\n\nwf:reworkPath a rdf:Seq ;\n  rdfs:label \"差戻し\"@ja ;\n  rdf:_1 wf:rework ;\n  rdf:_2 wf:review .\n\nwf:start a wf:StartEvent ;\n  rdfs:label \"開始\"@ja .\n\nwf:submit a wf:UserTask ;\n  rdfs:label \"申請を提出\"@ja .\n\nwf:review a wf:UserTask ;\n  rdfs:label \"内容を審査\"@ja ;\n  rdfs:seeAlso wf:approvalPolicy ;\n  wf:relatedTo wf:approvalPolicy ;\n  wf:retry wf:review .\n\nwf:approvalPolicy a wf:Reference ;\n  rdfs:label \"承認ポリシー\"@ja .\n\nwf:register a wf:ServiceTask ;\n  rdfs:label \"承認結果を登録\"@ja .\n\nwf:rework a wf:UserTask ;\n  rdfs:label \"内容を修正\"@ja .\n\nwf:end a wf:EndEvent ;\n  rdfs:label \"完了\"@ja .\n"
  },
