{
  "schemaVersion": "1",
  "kind": "iriograph.document",
  "documentId": "pizza-order-delivery-bilingual",
  "semantic": {
    "format": "text/turtle",
    "baseIri": "urn:iriograph:sample:pizza:",
    "authoringProfileRef": "urn:iriograph:authoring-profile:workflow-mock@1",
    "source": "@prefix pizza: <urn:iriograph:sample:pizza:> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\npizza:next a rdf:Property ;\n  rdfs:label \"次の工程\"@ja, \"Next step\"@en ;\n  rdfs:comment \"同じ業務の制御が次の工程へ進む関係\"@ja, \"Advances control to the next step in the same process\"@en .\n\npizza:branchesTo a rdf:Property ;\n  rdfs:subPropertyOf pizza:next ;\n  rdfs:label \"分岐する\"@ja, \"Branches to\"@en ;\n  rdfs:comment \"gatewayから複数の候補へ制御を分ける関係\"@ja, \"Splits control from a gateway into multiple alternatives\"@en .\n\npizza:mergesInto a rdf:Property ;\n  rdfs:subPropertyOf pizza:next ;\n  rdfs:label \"合流する\"@ja, \"Merges into\"@en ;\n  rdfs:comment \"分かれた制御をgatewayへ合流させる関係\"@ja, \"Merges split control back into a gateway\"@en .\n\npizza:sends a rdf:Property ;\n  rdfs:label \"送信する\"@ja, \"Sends\"@en ;\n  rdfs:comment \"業務主体が意味resourceを送信する関係\"@ja, \"A business participant sends a semantic resource\"@en .\n\npizza:receivedBy a rdf:Property ;\n  rdfs:label \"受信される\"@ja, \"Is received by\"@en ;\n  rdfs:comment \"送信された意味resourceを受け取る主体との関係\"@ja, \"Links a sent semantic resource to the participant that receives it\"@en .\n\npizza:about a rdf:Property ;\n  rdfs:label \"対象とする\"@ja, \"Is about\"@en ;\n  rdfs:comment \"message resourceが扱う対象との関係\"@ja, \"Links a message resource to the subject it concerns\"@en .\n\npizza:shop a rdf:Bag ;\n  rdfs:label \"ピザ店\"@ja, \"Pizza shop\"@en ;\n  rdfs:comment \"店員、調理担当、配達担当を含む事業者領域\"@ja, \"Business area containing the store, kitchen, and delivery staff\"@en ;\n  rdfs:member pizza:lane-staff, pizza:lane-kitchen, pizza:lane-delivery .\n\npizza:lane-customer a rdf:Bag ;\n  rdfs:label \"顧客\"@ja, \"Customer\"@en ;\n  rdfs:member pizza:lane1-c01, pizza:lane1-c02, pizza:lane1-c03, pizza:lane1-c04, pizza:lane1-c05, pizza:lane1-c06, pizza:lane1-c07, pizza:lane1-c09, pizza:lane1-c10, pizza:lane1-c11 .\n\npizza:lane-staff a rdf:Bag ;\n  rdfs:label \"店員\"@ja, \"Store staff\"@en ;\n  rdfs:member pizza:lane2-s01, pizza:lane2-s02, pizza:lane2-s03, pizza:lane2-s04, pizza:lane2-s05, pizza:lane2-s06 .\n\npizza:lane-kitchen a rdf:Bag ;\n  rdfs:label \"調理担当\"@ja, \"Kitchen staff\"@en ;\n  rdfs:member pizza:lane3-k01 .\n\npizza:lane-delivery a rdf:Bag ;\n  rdfs:label \"配達担当\"@ja, \"Delivery staff\"@en ;\n  rdfs:member pizza:lane4-d01, pizza:lane4-d02, pizza:lane4-d03 .\n\npizza:lane1-c01 rdfs:label \"おなかがすいた\"@ja, \"Hungry\"@en ;\n  pizza:next pizza:lane1-c02 .\n\npizza:lane1-c02 rdfs:label \"ピザを選ぶ\"@ja, \"Choose a pizza\"@en ;\n  pizza:next pizza:lane1-c03 .\n\npizza:lane1-c03 rdfs:label \"ピザを注文する\"@ja, \"Order a pizza\"@en ;\n  pizza:next pizza:lane1-c04 ;\n  pizza:sends pizza:order .\n\npizza:lane1-c04 rdfs:label \"注文後イベント\"@ja, \"Post-order event\"@en ;\n  rdfs:comment \"ピザの到着と60分タイマーのどちらかを待つevent gateway\"@ja, \"An event gateway that waits for either the pizza to arrive or the 60-minute timer\"@en ;\n  pizza:branchesTo pizza:lane1-c05, pizza:lane1-c06 .\n\npizza:lane1-c05 rdfs:label \"ピザを受け取る\"@ja, \"Receive the pizza\"@en ;\n  pizza:next pizza:lane1-c09 .\n\npizza:lane1-c06 rdfs:label \"60分待つ\"@ja, \"Wait 60 minutes\"@en ;\n  rdfs:comment \"注文から60分が経過したことを表すtimer event\"@ja, \"A timer event indicating that 60 minutes have elapsed since the order\"@en ;\n  pizza:next pizza:lane1-c07 .\n\npizza:lane1-c07 rdfs:label \"問い合わせる\"@ja, \"Make an inquiry\"@en ;\n  rdfs:comment \"問い合わせを送信した後は注文後イベントへ戻って待機を続ける\"@ja, \"After sending an inquiry, returns to the post-order event and continues waiting\"@en ;\n  pizza:sends pizza:inquiry ;\n  pizza:next pizza:lane1-c04 .\n\npizza:lane1-c09 rdfs:label \"代金を払う\"@ja, \"Pay\"@en ;\n  pizza:sends pizza:fee ;\n  pizza:next pizza:lane1-c10 .\n\npizza:lane1-c10 rdfs:label \"ピザを食べる\"@ja, \"Eat the pizza\"@en ;\n  pizza:next pizza:lane1-c11 .\n\npizza:lane1-c11 rdfs:label \"空腹が満たされた\"@ja, \"Hunger satisfied\"@en .\n\npizza:lane2-s01 rdfs:label \"注文を受ける\"@ja, \"Receive the order\"@en ;\n  pizza:next pizza:lane2-s02 .\n\npizza:lane2-s02 rdfs:label \"注文後処理を並行分岐\"@ja, \"Fork post-order tasks in parallel\"@en ;\n  rdfs:comment \"調理、問い合わせ受付、顧客クレーム対応を並行開始するparallel gateway\"@ja, \"A parallel gateway that starts cooking, inquiry intake, and complaint handling at the same time\"@en ;\n  pizza:branchesTo pizza:lane2-s03, pizza:lane2-s04, pizza:lane3-k01 .\n\npizza:lane2-s03 rdfs:label \"問い合わせ受付\"@ja, \"Receive inquiry\"@en ;\n  pizza:mergesInto pizza:lane2-s05 .\n\npizza:lane2-s04 rdfs:label \"顧客クレーム対応\"@ja, \"Handle customer complaint\"@en ;\n  pizza:mergesInto pizza:lane2-s05 .\n\npizza:lane2-s05 rdfs:label \"問い合わせに回答する\"@ja, \"Answer the inquiry\"@en ;\n  pizza:next pizza:lane2-s06 .\n\npizza:lane2-s06 rdfs:label \"問い合わせ対応完了\"@ja, \"Inquiry handling complete\"@en ;\n  rdfs:comment \"問い合わせまたはクレームへの回答を終え、次の連絡まで待機する\"@ja, \"Finishes answering the inquiry or complaint and waits for the next contact\"@en .\n\npizza:lane3-k01 rdfs:label \"ピザを焼く\"@ja, \"Bake the pizza\"@en ;\n  pizza:next pizza:lane4-d01 .\n\npizza:lane4-d01 rdfs:label \"ピザを配達する\"@ja, \"Deliver the pizza\"@en ;\n  pizza:sends pizza:pizza ;\n  pizza:next pizza:lane4-d02 .\n\npizza:lane4-d02 rdfs:label \"代金を受け取る\"@ja, \"Receive payment\"@en ;\n  pizza:sends pizza:receipt ;\n  pizza:next pizza:lane4-d03 .\n\npizza:lane4-d03 rdfs:label \"注文完了\"@ja, \"Order completed\"@en .\n\npizza:order rdfs:label \"注文\"@ja, \"Order\"@en ;\n  rdfs:comment \"顧客が選択したピザと配送依頼を表す注文resource\"@ja, \"An order resource representing the customer's selected pizza and delivery request\"@en ;\n  pizza:about pizza:pizza ;\n  pizza:receivedBy pizza:lane2-s01 .\n\npizza:pizza rdfs:label \"ピザ\"@ja, \"Pizza\"@en ;\n  rdfs:comment \"調理され顧客へ配送される商品resource\"@ja, \"A product resource that is cooked and delivered to the customer\"@en ;\n  pizza:receivedBy pizza:lane1-c05 .\n\npizza:fee rdfs:label \"料金\"@ja, \"Payment\"@en ;\n  rdfs:comment \"顧客が支払う代金resource\"@ja, \"A payment resource representing the amount paid by the customer\"@en ;\n  pizza:receivedBy pizza:lane4-d02 .\n\npizza:receipt rdfs:label \"領収書\"@ja, \"Receipt\"@en ;\n  rdfs:comment \"代金受領後に顧客へ渡す証憑resource\"@ja, \"A receipt resource given to the customer after payment is received\"@en ;\n  pizza:receivedBy pizza:lane1-c09 .\n\npizza:inquiry rdfs:label \"問い合わせ内容\"@ja, \"Inquiry details\"@en ;\n  rdfs:comment \"60分経過後に顧客が送る問い合わせresource\"@ja, \"An inquiry resource sent by the customer after 60 minutes have elapsed\"@en ;\n  pizza:about pizza:order ;\n  pizza:receivedBy pizza:lane2-s03 .\n"
  },
  "imports": [
    { "catalogRef": "urn:iriograph:catalog:workflow-instance-flow@1" }
  ],
  "views": [
    {
      "viewId": "main",
      "kind": "region",
      "profileRef": "urn:iriograph:profile:rdf-rdfs:instance-flow:1",
      "layoutRef": "urn:iriograph:layout:hierarchical-lr:1",
      "locale": "en",
      "overlay": {}
    }
  ]
}
